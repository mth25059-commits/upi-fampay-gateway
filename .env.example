# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill it in. `.env` is gitignored — your real
# values never get committed. Nothing here is read from anywhere but your own
# machine / server.
# ---------------------------------------------------------------------------

# 1) WHERE THE MONEY LANDS  (printed on the QR — not a secret, but a typo sends
#    every payment to a stranger, so double-check it)
UPI_ID=yourname@okhdfcbank
UPI_PAYEE_NAME=Your Name Or Business

# A short prefix for the human-readable reference (max 6 chars). Cosmetic.
PAYMENT_REF_PREFIX=PAY

# 2) THE INBOX THAT RECEIVES THE BANK ALERTS  (this is how a sale confirms
#    itself). Leave these two blank to run without auto-confirm — the gateway
#    still shows QR codes, it just won't settle them on its own.
#
#    IMPORTANT: IMAP_APP_PASSWORD is a Gmail *App Password*, NOT your Gmail
#    login password. Create one at https://myaccount.google.com/apppasswords
#    (needs 2-Step Verification on). Spaces in it are fine — they're stripped.
IMAP_USER=youraddress@gmail.com
IMAP_APP_PASSWORD=abcd efgh ijkl mnop

# Which address the payment alerts come FROM. Default is FamApp's. Change it if
# your bank/app sends from somewhere else (and update the wording regexes in
# src/mailbox.js to match — see samples/README.md).
IMAP_SENDER=no-reply@famapp.in

# Rarely need changing:
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_MAILBOX=INBOX
IMAP_LOOKBACK_HOURS=12

# 3) TIMING  (minutes). How long a quoted amount stays reserved for one order,
#    and how long past that it still owns the amount so a late credit can't be
#    re-attributed to the next buyer.
PAYMENT_WINDOW_MINUTES=15
PAYMENT_GRACE_MINUTES=30

# The demo server's port.
PORT=4400
